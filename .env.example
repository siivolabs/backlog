# Chemin hôte utilisé par compose.yaml
DATA_PATH=./data
# Jeton obligatoire pour toute opération d'administration
ADMIN_TOKEN=remplacez-moi-par-un-secret-long
# Ollama joignable depuis le conteneur
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_ANALYSIS_MODEL=qwen3:32b
AI_EMBEDDING_MODEL=embeddinggemma
# Paramètres optionnels
PORT=3000
DATABASE_PATH=/data/backlog-core.sqlite
STEAM_ENRICHMENT_ENABLED=true
REQUEST_TIMEOUT_MS=120000

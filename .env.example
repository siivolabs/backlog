# Copiez ce fichier vers .env avant le déploiement.
BACKLOG_PORT=3000
DATA_PATH=/chemin/absolu/vers/le/volume/data/existant

# Ollama accessible depuis l'hôte Docker.
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_ANALYSIS_MODEL=qwen3:32b
EMBEDDING_MODEL=embeddinggemma
AI_TIMEOUT_MS=180000

# Collecte de faits officiels Steam au moment de l'enrichissement.
STEAM_FETCH_ENABLED=true

# Facultatif : protège les actions d'enrichissement et de réimport.
# ADMIN_TOKEN=remplacez-moi-par-un-secret-long
